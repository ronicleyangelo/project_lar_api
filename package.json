{
  "name": "projeto-lar-backend",
  "version": "1.0.0",
  "description": "Backend API para o Projeto Lar - Marketplace de Serviços Domésticos",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "categories:sync": "ts-node src/infrastructure/database/sync-categories.ts",
    "audit:flow": "node scripts/audit-flow.js",
    "seed": "ts-node src/infrastructure/database/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^4.16.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^4.16.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^18.19.130",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
