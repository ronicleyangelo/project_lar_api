DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-your-web-client-id.apps.googleusercontent.com
FRONTEND_URL=http://localhost:4200
PORT=3000
NODE_ENV=development
COOKIE_DOMAIN=                # Ex: .projetolar.com (vazio para dev)
ENCRYPTION_MASTER_KEY=        # Base64 de exatamente 32 bytes; nunca troque após gravar dados
BACKEND_URL=http://localhost:3000
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=http://localhost:3000/api/payments/mercado-pago/callback
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TEST_MODE=true
PLATFORM_FEE_PERCENT=12
PAYMENTS_REQUIRED=false       # Altere para true quando o checkout estiver homologado
